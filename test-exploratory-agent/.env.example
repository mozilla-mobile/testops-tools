# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# ── Required ───────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Device / platform (all optional — override CLI defaults) ───────────────────
# PLATFORM=ios                         # ios | android  (default: ios)
# DEVICE_UDID=auto                     # 'auto' = detect first booted/connected
# DEVICE_NAME=iPhone 15                # display name of the device
# PLATFORM_VERSION=17.5                # OS version
# APP_ID=org.mozilla.ios.Fennec        # iOS bundle ID or Android package name
# APP_ACTIVITY=org.mozilla.fenix.HomeActivity  # Android only

# ── Appium server ──────────────────────────────────────────────────────────────
# APPIUM_URL=http://127.0.0.1:4723     # override for remote Appium grids
