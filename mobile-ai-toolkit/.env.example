# TestRail configuration — copy to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# Generate an API key at: TestRail > My Settings > API Keys.

TESTRAIL_URL=https://<your-instance>.testrail.io
TESTRAIL_USER=your.name@example.com
TESTRAIL_API_KEY=

# --------------------------------------------------------------------------- #
# Import target — where testrail_import.py CREATES cases
# Critical/High/Medium go to TESTRAIL_SUITE_ID; Low goes to TESTRAIL_SUITE_ID_LOW.
# TESTRAIL_SUITE_ID_LOW is required only when a CSV contains Low-priority cases.
# --------------------------------------------------------------------------- #
TESTRAIL_PROJECT_ID=
TESTRAIL_SUITE_ID=
TESTRAIL_SUITE_ID_LOW=

# --------------------------------------------------------------------------- #
# Documentation source — where testrail_fetch_section.py READS from
# Deliberately separate from the import target, so documenting a shipped
# feature never depends on wherever the last import ran.
# Defaults if unset: project 14 (Firefox for iOS), suite 45443
# (Full Functional Tests Suite).
# --------------------------------------------------------------------------- #
TESTRAIL_iOS_PROJECT_ID=14
TESTRAIL_FULL_SUITE_ID=45443

# --------------------------------------------------------------------------- #
# Case field mapping — defaults suit a standard TestRail project.
# Change only if your project renames these custom fields.
# --------------------------------------------------------------------------- #
TESTRAIL_PRECONDITIONS_FIELD=custom_preconds
TESTRAIL_STEPS_FIELD=custom_steps
TESTRAIL_EXPECTED_FIELD=custom_expected
TESTRAIL_REFERENCES_FIELD=refs

# Optional, with sensible defaults in code:
# TESTRAIL_SEPARATED_STEPS_FIELD=custom_steps_separated
# TESTRAIL_SUB_TEST_SUITE_FIELD=custom_sub_test_suites
# TESTRAIL_EXTERNAL_ID_FIELD=custom_external_id

# --------------------------------------------------------------------------- #
# Behaviour
# Set USE_SEPARATED_STEPS=true with a steps-style template (e.g. "Test Case
# (Steps)") to store each step paired with its expected result.
# --------------------------------------------------------------------------- #
TESTRAIL_TEMPLATE_ID=2
TESTRAIL_USE_SEPARATED_STEPS=true
TESTRAIL_REQUEST_TIMEOUT=30
TESTRAIL_MAX_RETRIES=3
