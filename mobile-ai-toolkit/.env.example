# TestRail configuration — copy to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# Generate an API key at: TestRail > My Settings > API Keys.

TESTRAIL_URL=https://<your-instance>.testrail.io
TESTRAIL_USER=your.name@example.com
TESTRAIL_API_KEY=

# --------------------------------------------------------------------------- #
# Project 1 — "Firefox for iOS" (*)  ** PRODUCTION **
#   https://mozilla.testrail.io/index.php?/projects/overview/14
# The official project holding the test cases the Firefox for iOS team runs.
# Where testrail_fetch_section.py READS from, and the first option the
# automation agents offer (`--project 1` / `firefox-ios`). Deliberately
# separate from the import target, so documenting a shipped feature never
# depends on wherever the last import ran.
# Writing here needs the user's explicit confirmation and, for the triager,
# --confirm-firefox-ios.
# --------------------------------------------------------------------------- #
TESTRAIL_iOS_PROJECT_ID=14
TESTRAIL_iOS_FULL_SUITE_ID=45443

# --------------------------------------------------------------------------- #
# Project 2 — "[TEMP] iOS test project for TC approvals"
#   https://mozilla.testrail.io/index.php?/projects/overview/92
# The import target (where testrail_import.py CREATES cases) and the second
# option the automation agents offer (`--project 2` / `temp-approvals`).
# Critical/High/Medium go to TESTRAIL_TMP_SUITE_ID; Low goes to TESTRAIL_TMP_SUITE_ID_LOW.
# TESTRAIL_TMP_SUITE_ID_LOW is required only when a CSV contains Low-priority cases.
# --------------------------------------------------------------------------- #
TESTRAIL_TMP_PROJECT_ID=92
TESTRAIL_TMP_SUITE_ID=107983
TESTRAIL_TMP_SUITE_ID_LOW=

# --------------------------------------------------------------------------- #
# Automation triage — where automation-triager reads and writes
# The project is chosen by the user at the start of every run, never defaulted:
#   --project 1 | firefox-ios     reads TESTRAIL_iOS_PROJECT_ID + TESTRAIL_iOS_FULL_SUITE_ID
#   --project 2 | temp-approvals  reads TESTRAIL_TMP_PROJECT_ID + TESTRAIL_TMP_SUITE_ID
# Only the selected pair is read, and a missing or non-integer value stops the
# run rather than falling back to the other project. Both agents analyse the
# local XCUITest checkout below. XCUITEST_REPO_PATH is required; the run fails
# with an actionable error if it is unset or not a directory.
# The Automation field's option ids (Untriaged/Suitable/Unsuitable) are
# resolved from TestRail metadata at runtime, never hardcoded.
# --------------------------------------------------------------------------- #
XCUITEST_REPO_PATH=/path/to/firefox-ios

# --------------------------------------------------------------------------- #
# Automation script writer — branch naming
# Branches are created in XCUITEST_REPO_PATH as <MOZILLA_USERNAME>/<ticket_no>,
# e.g. dbigu/MTE-1234. If unset, the agent falls back to the local part of
# `git config user.email` and confirms it with you.
# --------------------------------------------------------------------------- #
MOZILLA_USERNAME=

# Optional, with defaults in code:
# TESTRAIL_AUTOMATION_STATUS_FIELD=custom_automation_status

# --------------------------------------------------------------------------- #
# Case field mapping — defaults suit a standard TestRail project.
# Change only if your project renames these custom fields.
# --------------------------------------------------------------------------- #
TESTRAIL_PRECONDITIONS_FIELD=custom_preconds
TESTRAIL_STEPS_FIELD=custom_steps
TESTRAIL_EXPECTED_FIELD=custom_expected
TESTRAIL_REFERENCES_FIELD=refs

# Optional, with sensible defaults in code:
# TESTRAIL_SEPARATED_STEPS_FIELD=custom_steps_separated
# TESTRAIL_SUB_TEST_SUITE_FIELD=custom_sub_test_suites
# TESTRAIL_EXTERNAL_ID_FIELD=custom_external_id

# --------------------------------------------------------------------------- #
# Behaviour
# Set USE_SEPARATED_STEPS=true with a steps-style template (e.g. "Test Case
# (Steps)") to store each step paired with its expected result.
# --------------------------------------------------------------------------- #
TESTRAIL_TEMPLATE_ID=2
TESTRAIL_USE_SEPARATED_STEPS=true
TESTRAIL_REQUEST_TIMEOUT=30
TESTRAIL_MAX_RETRIES=3
